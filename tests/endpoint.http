# REST Client tests (VS Code REST Client)
###
GET http://localhost:3000/health
Accept: application/json

###
GET http://localhost:3000/api/v1/orders
Accept: application/json

###
GET http://localhost:3000/api/v1/orders?limit=1
Accept: application/json

###
GET http://localhost:3000/api/v1/orders/order_001
Accept: application/json

###
# Create order (should FAIL without API key)
POST http://localhost:3000/api/v1/orders
Content-Type: application/json
Accept: application/json

{
  "product_id": "plant_001",
  "product_name": "Monstera Deliciosa",
  "quantity": 1,
  "price_cents": 2999,
  "currency": "SEK",
  "owner_user_id": "user::liquid_01"
}

###
# Create order (should SUCCEED with API key)
POST http://localhost:3000/api/v1/orders
Content-Type: application/json
Accept: application/json
X-API-Key: dev-key-12345

{
  "product_id": "plant_001",
  "product_name": "Monstera Deliciosa",
  "quantity": 1,
  "price_cents": 2999,
  "currency": "SEK",
  "owner_user_id": "user::liquid_01"
}

###
# Update order status (replace order_XXX with the id you got from the create response)
PATCH http://localhost:3000/api/v1/orders/order_1771697300071/status
Content-Type: application/json
Accept: application/json
X-API-Key: dev-key-12345

{
  "status": "shipped"
}
